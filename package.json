{
  "name": "kol-mirror",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "vite --force",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-previews": "node scripts/generate-previews.mjs",
    "generate-patch-thumbs": "node scripts/generate-patch-thumbs.mjs",
    "check:feedback": "node scripts/check-feedback.mjs",
    "test": "node --test src/**/*.test.mjs",
    "api:dev": "wrangler dev --config api/wrangler.toml --port 8788",
    "api:schema": "wrangler d1 execute kol-mirror --remote --file api/schema.sql --config api/wrangler.toml",
    "api:schema:local": "wrangler d1 execute kol-mirror --local --file api/schema.sql --config api/wrangler.toml",
    "api:deploy": "wrangler deploy --config api/wrangler.toml",
    "check:library-merge": "node scripts/check-library-merge.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@kolkrabbi/kol-brand": "0.2.0",
    "@kolkrabbi/kol-component": "^0.311.0",
    "@kolkrabbi/kol-framework": "^0.61.0",
    "@kolkrabbi/kol-hardware": "^0.8.0",
    "@kolkrabbi/kol-icons": "0.52.0",
    "@kolkrabbi/kol-media-client": "0.7.0",
    "@kolkrabbi/kol-shell": "0.87.0",
    "@kolkrabbi/kol-theme": "^0.196.0",
    "@tailwindcss/vite": "^4.3.3",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "vite": "^8.2.2",
    "wrangler": "^4.149.0"
  }
}
